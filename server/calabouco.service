[Unit]
Description=Calabouço da Morte - Game Server + Leaderboard API
After=network.target

[Service]
Type=simple
User=marcelo
WorkingDirectory=/home/marcelo/calabouco-da-morte
ExecStart=/usr/bin/node /home/marcelo/calabouco-da-morte/server/combined-server.mjs
Restart=always
RestartSec=5
Environment=PORT=3333
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
